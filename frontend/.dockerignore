# Applies to the `frontend` service build context (build.context: ./frontend).
#
# IMPORTANT: unlike the root .dockerignore, this one deliberately does NOT
# exclude .env* — Next.js reads frontend/.env.production.local during the
# `RUN npm run build` step inside the Dockerfile's builder stage to bake in
# NEXT_PUBLIC_* values (they're compiled into the JS bundle, not read at
# runtime). That file must exist in this directory on the server BEFORE
# `docker compose build` runs, created by hand once (see deploy.sh) — never
# rsynced from a local machine, and never any OTHER .env* file left here by
# mistake (a stray .env.local with dev/test values would silently get baked
# in instead — keep exactly one, correct, production env file present).

node_modules/
.next/
.git/
e2e/
test-results/
playwright-report/
coverage/
*.log
.DS_Store
