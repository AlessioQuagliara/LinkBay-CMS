# ── Next.js Frontend — Variabili d'ambiente ──────────────────────────────────
# Copia in .env.local per sviluppo.
#
# Per il deploy Docker in produzione: copia in frontend/.env.production.local
# DIRETTAMENTE SUL SERVER, creato a mano una volta sola — mai sincronizzato
# da una macchina locale (vedi scripts/deploy.sh). Next.js legge questo file
# durante `RUN npm run build` dentro il Dockerfile del frontend (fase builder),
# quindi deve esistere PRIMA di `docker compose build`, non dopo: i valori
# NEXT_PUBLIC_* qui sotto vengono compilati dentro il bundle JS in quel
# momento, non letti a runtime — cambiarli dopo la build non ha effetto finché
# non rifai il build. Verifica che non ci sia ANCHE un .env.local o .env con
# valori diversi nella stessa cartella sul server: Next.js li carica entrambi
# e uno stale potrebbe vincere silenziosamente.

# URL registrazione Agency (PHP backend)
NEXT_PUBLIC_AGENCY_REGISTER_URL=https://api.linkbay-cms.com/agency/register

# URL login / dashboard Agency
NEXT_PUBLIC_AGENCY_LOGIN_URL=https://api.linkbay-cms.com/linkbay-admin

# URL "trova la tua agenzia" (Agency::find)
NEXT_PUBLIC_AGENCY_FINDER_URL=https://api.linkbay-cms.com/agency/find

# URL base API backend per le chiamate storefront (account, cart, checkout,
# catalogo). DEVE contenere il placeholder {slug}: il backend Laravel risolve
# il tenant dal dominio della richiesta (stancl/tenancy domain-based), quindi
# ogni tenant ha il proprio host — vedi TenantProvisioningService::registerDomain
# ({tenant_id}.STORE_DOMAIN). Un dominio centrale/condiviso qui NON funziona:
# viene rifiutato da PreventAccessFromCentralDomains sulle rotte tenant.
NEXT_PUBLIC_API_BASE_URL=https://{slug}.yoursite-linkbay-cms.com

# URL canonico del sito marketing (usato per sitemap/robots/metadata assoluti)
NEXT_PUBLIC_SITE_URL=https://linkbay-cms.com

# Stripe publishable key (storefront checkout)
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# Dominio principale del marketing site — usato da middleware.ts per capire se
# un host è il sito centrale o un subdomain tenant (default: linkbay-cms.com)
NEXT_PUBLIC_MAIN_DOMAIN=linkbay-cms.com

# Subdomain routing — custom domain map (opzionale, per domini custom dei tenant
# che non sono un subdomain di NEXT_PUBLIC_MAIN_DOMAIN)
# Format: CUSTOM_DOMAIN_MAP={"shop.miodominio.com":"my-agency-slug"}
CUSTOM_DOMAIN_MAP=
