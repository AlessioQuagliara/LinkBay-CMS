# =============================================================================
# root/.env.example — LinkBayCMS
# =============================================================================
# Questo file è il template BASE per produzione/staging.
# Per sviluppo locale usa i valori .test nel tuo root .env e l'override:
#   docker compose -f compose.yaml -f compose.override.local.yml up -d
#
# Copia in .env e compila i valori. NON committare mai .env con segreti reali.
# =============================================================================

# ── Ambiente ─────────────────────────────────────────────────────────────────
# Produzione: production | Locale: local (abilita auto-approve agency)
APP_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=saas_db

# ── Dominio principale ────────────────────────────────────────────────────────
# Usato da:
#   - Traefik router rule nel compose.yaml (app./admin./api.CENTRAL_DOMAIN →
#     Laravel; qualsiasi altro subdomain → frontend Next.js, storefront pages)
#   - Laravel CENTRAL_DOMAIN (governa panelDomain, RegisterController, Filament,
#     config/tenancy.php central_domains)
#   - SESSION_DOMAIN (cookie cross-subdomain)
# In produzione: linkbay-cms.com
# In locale:     linkbay-cms.test (override in compose.override.local.yml)
CENTRAL_DOMAIN=linkbay-cms.com
SESSION_DOMAIN=.linkbay-cms.com

# Dominio dei tenant/store cliente — DEVE essere diverso da CENTRAL_DOMAIN
# sopra (un dominio centrale viene rifiutato dalle rotte tenant da
# PreventAccessFromCentralDomains). Ogni store creato registra
# {tenant_id}.STORE_DOMAIN come proprio dominio (vedi
# TenantProvisioningService::registerDomain) — è lì che vivono il pannello
# Filament /admin del tenant e le API api/store/*, api/v1/*. Serve anche il
# relativo Traefik router in compose.yaml (prod-store-wildcard).
# In produzione: sostituire con un dominio/subdomain che controlli davvero —
# "yoursite-linkbay-cms.com" è solo un placeholder, non è registrabile per te.
# In locale:     yoursite-linkbay-cms.test (override in compose.override.local.yml,
#                dove è già impostato anche dentro l'ambiente del container php)
STORE_DOMAIN=yoursite-linkbay-cms.com

# NOTA: FRONTEND_URL (dove Laravel reindirizza chi arriva su "/" senza una
# rotta più specifica, e i link "torna al sito" nelle pagine invito/careers/
# contatti) NON vive qui — va impostato direttamente in backend/.env sul
# server, perché il servizio php in compose.yaml legge SOLO quel file come
# env_file (root .env alimenta solo le sostituzioni ${VAR} nei file compose
# stessi, non l'ambiente del container). Lasciarlo non impostato in produzione
# manda i visitatori reali a http://localhost:3000 — vedi backend/.env.example.

# ── TLS/HTTPS (solo con compose.prod.yaml) ───────────────────────────────────
# Email richiesta da Let's Encrypt per l'account ACME (notifiche di scadenza
# certificato, non pubblica). Serve solo se usi:
#   docker compose -f compose.yaml -f compose.prod.yaml up -d
ACME_EMAIL=you@yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# Le chiavi con prefisso APP_STRIPE_* vengono rimappate dal compose.yaml
# ai nomi che Laravel config/services.php si aspetta (STRIPE_KEY, STRIPE_SECRET, ecc.)
APP_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
APP_STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# Per locale test mode: pk_test_... e sk_test_... dal Stripe Dashboard
APP_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
APP_STRIPE_PRICE_STARTER=price_REPLACE_ME
APP_STRIPE_PRICE_PRO=price_REPLACE_ME
APP_STRIPE_PRICE_BUSINESS=price_REPLACE_ME

# ── Node-RED ──────────────────────────────────────────────────────────────────
NODE_RED_CREDENTIAL_SECRET=REPLACE_ME

# ── Frontend (Next.js SSR) ────────────────────────────────────────────────────
# Usato da Next.js lato server (SSR, letto a ogni richiesta — vedi
# app/storefront/page.tsx e simili). I valori NEXT_PUBLIC_* client-side
# vengono invece baked al build time dal file frontend/.env.local (non da qui).
# DEVE contenere il placeholder {slug} e puntare a STORE_DOMAIN, non
# CENTRAL_DOMAIN — un dominio centrale qui viene rifiutato da
# PreventAccessFromCentralDomains su ogni rotta tenant.
NEXT_PUBLIC_API_BASE_URL=https://{slug}.yoursite-linkbay-cms.com

# ── TensorFlow Serving (profilo ml) ──────────────────────────────────────────
TF_MODEL_NAME=linkbay_model

# ── Panels (reference) ───────────────────────────────────────────────────────
# Super Admin:  https://app.linkbay-cms.com/linkbay-admin
# Agency panel: https://{slug}.linkbay-cms.com/dashboard
# Tenant panel: https://{subdomain}.linkbay-cms.com/admin
# Agency reg:   https://app.linkbay-cms.com/agency/register
