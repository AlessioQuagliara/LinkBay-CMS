# Copia questo file in .env e adatta i valori.

# Chiave usata da Flask per firmare sessioni e CSRF token.
# In sviluppo va bene un valore qualsiasi; in produzione usa un valore
# lungo e casuale (es. python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=dev-secret-change-me

# Stringa di connessione al database Postgres.
# Valore di default: punta al Postgres avviato con `docker compose up -d db`
# (porta 5432 pubblicata sull'host).
DATABASE_URL=postgresql://linkbay:linkbay@localhost:5432/linkbay_cms

# URL base pubblico con cui l'app è raggiunta. Usato per il redirect URI OAuth
# di Google, per canonical/Open Graph/JSON-LD e per la sitemap.
# In locale: http://localhost:3000
# In produzione: https://www.linkbay-cms.com  (con https, l'app abilita anche
#   i cookie di sessione sicuri — vedi config.py).
APP_BASE_URL=http://localhost:3000

# Credenziali OAuth2 del client "Web application" creato in Google Cloud
# Console (API Search Console abilitata). Il redirect URI da autorizzare lì
# è {APP_BASE_URL}/gsc/callback (es. http://localhost:3000/gsc/callback in
# locale, https://www.linkbay-cms.com/gsc/callback in produzione).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opzionale ma consigliata in produzione: forza il redirect URI OAuth esatto,
# invece di dedurlo dalla richiesta. Deve combaciare al carattere con quello
# autorizzato in Google Cloud Console.
# GOOGLE_REDIRECT_URI=https://www.linkbay-cms.com/gsc/callback

# Scope richiesti a Google. Più valori separati da virgola.
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly

# Cloudflare Turnstile — verifica anti-bot sul form di registrazione (vedi
# app/auth/captcha.py). Crea un widget su
# dash.cloudflare.com/?to=/:account/turnstile (tipo "Managed") e incolla qui
# Site Key e Secret Key. Se lasciate vuote, il captcha non compare e la
# verifica è saltata: da configurare prima di andare in produzione.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chiave usata per cifrare (Fernet) gli access/refresh token di Search
# Console prima di salvarli in DB. Generane una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Redis — broker della coda RQ (app/jobs/), consumata dal servizio "worker"
# in compose.yml/compose.prod.yml. Valore di default: punta al Redis avviato
# con `docker compose up -d redis` (porta interna al network Docker, non
# pubblicata sull'host).
REDIS_URL=redis://localhost:6379/0

# Token API di Cloudflare usato da Traefik per la DNS-01 challenge
# (necessaria per il certificato wildcard *.linkbay-cms.com + linkbay-cms.com).
# Crea un token scoped in Cloudflare (My Profile > API Tokens) con permesso
# "Zone / DNS / Edit" sulla zona linkbay-cms.com.
CF_DNS_API_TOKEN=


# DeepSeek — AI Analyzer (endpoint OpenAI-compatibile). Se assente, lo switch
# AI resta disattivabile ma l'analisi risponde "non configurata".
DEEPSEEK_API=
# Opzionali (default sensati): base URL e modello.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Resend — invio email transazionali (codici OTP di verifica).
# RESEND_API: la API key dal dashboard Resend (inizia con re_).
# RESEND_FROM: mittente, deve usare un dominio verificato su Resend.
RESEND_API=
RESEND_FROM=LinkBayCMS <no-reply@linkbay-cms.com>

# OTP (email al login/registrazione) — valori di default sensati.
# OTP_TTL_SECONDS=600
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN=60

# Paddle Billing — provider principale per abbonamenti Pro e crediti AI
# (checkout server-driven, webhook firmati). Vedi docs/paddle-billing.md per
# l'architettura completa, il setup del webhook e la checklist go-live.
# AppSumo resta attivo come canale lifetime separato, non sostituito da Paddle.

# "sandbox" o "production" — l'UNICA leva che decide sia il base URL API
# Paddle sia quale set di price ID sotto viene usato. Lascia "sandbox"
# finché non hai completato il go-live checklist in docs/paddle-billing.md.
PADDLE_ENVIRONMENT=sandbox

# Paddle Dashboard > Developer Tools > Authentication > API key. MAI
# esposta al frontend — solo letta server-side. Usa la chiave sandbox
# finché PADDLE_ENVIRONMENT=sandbox, quella production solo dopo.
PADDLE_API_KEY=

# Paddle Dashboard > Developer Tools > Notifications > (il tuo endpoint) >
# "Signing secret" — usato SOLO per verificare la firma del webhook, mai per
# autenticare richieste in uscita verso Paddle.
PADDLE_WEBHOOK_SECRET=

# URL di ritorno dopo il pagamento. Se lasciata vuota, si usa la pagina
# interna /billing/paddle/pending (fa polling su /billing/status finché il
# webhook non conferma) — quasi sempre la scelta giusta, non impostarla a
# meno di avere una pagina di ringraziamento dedicata.
PADDLE_SUCCESS_URL=

# Price ID Paddle SANDBOX per i tre piani Pro (vedi
# app/billing/paddle_products.py::PADDLE_PLAN_PRICES) e per i tre pacchetti
# crediti AI. Popolali con `flask paddle-sync-catalog
# --environment sandbox` (crea/recupera prodotto+price in Paddle e stampa
# questi valori) — vedi docs/paddle-billing.md.
PADDLE_SANDBOX_PRICE_ID_1M=
PADDLE_SANDBOX_PRICE_ID_3M=
PADDLE_SANDBOX_PRICE_ID_12M=
PADDLE_SANDBOX_PRICE_ID_AI_TOPUP_STARTER=
PADDLE_SANDBOX_PRICE_ID_AI_TOPUP_GROWTH=
PADDLE_SANDBOX_PRICE_ID_AI_TOPUP_SCALE=

# Equivalenti PRODUCTION — MAI gli stessi ID di sandbox. Popolali con
# `flask paddle-sync-catalog --environment production` solo quando sei
# pronto per il go-live (vedi checklist in docs/paddle-billing.md).
PADDLE_PRODUCTION_PRICE_ID_1M=
PADDLE_PRODUCTION_PRICE_ID_3M=
PADDLE_PRODUCTION_PRICE_ID_12M=
PADDLE_PRODUCTION_PRICE_ID_AI_TOPUP_STARTER=
PADDLE_PRODUCTION_PRICE_ID_AI_TOPUP_GROWTH=
PADDLE_PRODUCTION_PRICE_ID_AI_TOPUP_SCALE=