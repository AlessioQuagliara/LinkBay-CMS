# Copia questo file in .env e adatta i valori.

# Chiave usata da Flask per firmare sessioni e CSRF token.
# In sviluppo va bene un valore qualsiasi; in produzione usa un valore
# lungo e casuale (es. python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=dev-secret-change-me

# Stringa di connessione al database Postgres.
# Valore di default: punta al Postgres avviato con `docker compose up -d db`
# (porta 5432 pubblicata sull'host).
DATABASE_URL=postgresql://linkbay:linkbay@localhost:5432/linkbay_cms
