APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# In staging/production add ,slack to also push critical-level logs (failed
# queue jobs — see AppServiceProvider::boot — and any other Log::critical) to
# Slack: LOG_STACK=single,slack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Slack incoming webhook URL (Slack app → Incoming Webhooks). Only read when
# 'slack' is part of LOG_STACK above.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Failed jobs are recorded in the failed_jobs table regardless of driver above —
# visible in the Admin panel under Operations → Failed Jobs.
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# local dev: MAIL_MAILER=log writes emails to storage/logs/laravel.log instead
# of sending them. For a real demo (welcome email, password reset, order
# confirmation) switch to smtp and point at Mailtrap/Resend/SES sandbox creds —
# storefront/account flows depend on mail actually being delivered.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Frontend (marketing site) URL ────────────────────────────────────────────
# Where Laravel sends visitors who hit a route with no dedicated response of
# its own — the central "/" catch-all (routes/web.php) and ~14 Blade views
# ("back to site" links: agency-invite, client-invite, careers, contact
# success). Defaults to the Next.js dev server so local dev/CI need nothing
# extra. In production this MUST be the real marketing domain — leaving it
# unset in prod silently redirects real visitors to http://localhost:3000
# (this happened once; see docs/demo-runbook.md and the incident it caused).
FRONTEND_URL=http://localhost:3000

# ── Production-only overrides (NOT read from this file in local dev/CI) ─────
# compose.yaml's `php` service maps these into the container from the ROOT
# .env via `environment:` (with name remapping for Stripe — see .env.example),
# NOT from this file — the values below exist only as a reference of what
# ends up set and where to change it. Do not duplicate them into backend/.env
# on the server; it would just be dead weight since compose.yaml's explicit
# `environment:` block always wins over anything env_file provides for the
# same key.
#   CENTRAL_DOMAIN, SESSION_DOMAIN, STORE_DOMAIN  → root .env
#   STRIPE_KEY, STRIPE_SECRET, STRIPE_WEBHOOK_SECRET
#     → root .env as APP_STRIPE_PUBLISHABLE_KEY / APP_STRIPE_SECRET_KEY /
#       APP_STRIPE_WEBHOOK_SECRET, remapped by compose.yaml
#
# Vars that DO belong directly in backend/.env on the server, set by hand,
# never synced from a local machine (see scripts/deploy.sh):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_KEY=                (generate on the server: php artisan key:generate)
#   APP_URL=https://app.linkbay-cms.com
#   SESSION_DRIVER=redis
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
#   MAIL_MAILER=smtp        (+ real MAIL_HOST/PORT/USERNAME/PASSWORD — the
#                            storefront's order-confirmation/welcome/password
#                            reset emails depend on mail actually sending)
#   SANCTUM_STATEFUL_DOMAINS=linkbay-cms.com,app.linkbay-cms.com,admin.linkbay-cms.com
#   FRONTEND_URL=https://linkbay-cms.com   (see above — do not leave unset)
